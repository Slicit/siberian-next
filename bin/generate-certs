#!/usr/bin/env bash
# Generates a local certificate authority and a wildcard certificate for
# development.
#
# Two reasons this is not optional. Browsers hardcode .localhost to 127.0.0.1,
# so a development domain on that TLD can never point at another machine; and
# they increasingly refuse plain HTTP for anything that looks like an app. So
# development uses a real-shaped domain over real TLS, signed by a CA you trust
# once. The domain is under .test, which RFC 6761 reserves for exactly this and
# which no registry can ever delegate out from under the box.
#
# The wildcards matter: certificates match one label at a time, so
# *.siberian.test covers core.siberian.test but does NOT cover
# tasks.apps.siberian.test. Every level a module origin can appear at needs its
# own entry, which is exactly the kind of thing that is discovered at 2am
# rather than read in a spec.
#
# Several domains are one certificate, not several: the Router holds exactly
# one, and multi-domain means more names in the same SAN list.
#
#   SIBERIAN_DOMAINS="siberian.test siberian-second.test" bin/generate-certs
set -euo pipefail
cd "$(dirname "$0")/.."

DOMAINS="${SIBERIAN_DOMAINS:-${SIBERIAN_DOMAIN:-siberian.test}}"
DOMAINS=$(echo "$DOMAINS" | tr ',' ' ')
PRIMARY=$(echo "$DOMAINS" | awk '{print $1}')
OUT="deploy/certs"
DAYS="${CERT_DAYS:-825}"

mkdir -p "$OUT"

if [ -f "$OUT/ca.pem" ] && [ -f "$OUT/server.pem" ] && [ "${FORCE:-}" != "true" ]; then
  echo "Certificates already exist in $OUT. Set FORCE=true to regenerate."
  openssl x509 -in "$OUT/server.pem" -noout -subject -enddate
  exit 0
fi

# The CA outlives the server certificate, deliberately.
#
# Adding a domain means reissuing the leaf with a longer SAN list, and that is a
# routine thing to do. Reissuing the CA is not: every machine that trusted the
# old one stops trusting anything, including browsers on other people's
# laptops, and the failure looks like the site being broken rather than like a
# certificate being replaced.
#
# So FORCE reissues the leaf and keeps the CA. Removing deploy/certs/ca.pem is
# the deliberate act that makes a new one, and it is deliberate because it costs
# everybody a re-trust.
if [ -f "$OUT/ca.pem" ] && [ -f "$OUT/ca-key.pem" ]; then
  echo "Keeping the existing development CA. Delete $OUT/ca.pem to make a new one."
else
  echo "Generating a development CA..."
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -keyout "$OUT/ca-key.pem" -out "$OUT/ca.pem" \
    -subj "/CN=Siberian Development CA/O=Siberian" 2>/dev/null
fi

# Three names per domain: the domain itself, one label under it for core and
# for anything else the core serves, and one label under apps for the module
# origins. Numbered in one sequence, because openssl ignores a repeated key.
alt=""
n=0
for domain in $DOMAINS; do
  n=$((n + 1)); alt="${alt}DNS.${n} = ${domain}"$'\n'
  n=$((n + 1)); alt="${alt}DNS.${n} = *.${domain}"$'\n'
  n=$((n + 1)); alt="${alt}DNS.${n} = *.apps.${domain}"$'\n'
done
n=$((n + 1)); alt="${alt}DNS.${n} = localhost"$'\n'

cat > "$OUT/server.cnf" <<CNF
[req]
distinguished_name = dn
req_extensions     = ext
prompt             = no

[dn]
CN = ${PRIMARY}
O  = Siberian Development

[ext]
subjectAltName   = @alt
basicConstraints = CA:FALSE
keyUsage         = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt]
${alt}IP.1  = 127.0.0.1
CNF

echo "Generating a server certificate for: ${DOMAINS}"
openssl req -new -newkey rsa:2048 -nodes \
  -keyout "$OUT/server-key.pem" -out "$OUT/server.csr" \
  -config "$OUT/server.cnf" 2>/dev/null

openssl x509 -req -in "$OUT/server.csr" -days "$DAYS" \
  -CA "$OUT/ca.pem" -CAkey "$OUT/ca-key.pem" -CAcreateserial \
  -out "$OUT/server.pem" \
  -extfile "$OUT/server.cnf" -extensions ext 2>/dev/null

rm -f "$OUT/server.csr" "$OUT/ca.pem.srl" "$OUT/.srl"
chmod 600 "$OUT"/*-key.pem

echo
openssl x509 -in "$OUT/server.pem" -noout -subject -ext subjectAltName -enddate
echo
echo "Trust $OUT/ca.pem on any machine that will open the app."
