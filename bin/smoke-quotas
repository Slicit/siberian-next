#!/usr/bin/env bash
# Storage quotas: the operator default that caps what a manifest may ask for,
# the per bucket allowance, and the per domain one every bucket shares.
#
# From inside the core network, because the Storage service is reachable by
# service name and by nothing else.
#
# The whole bin directory is mounted rather than the one script, so the shared
# assertion helper comes with it.
set -euo pipefail
cd "$(dirname "$0")/.."
exec docker run --rm --network siberian_core -v "$PWD/bin:/smoke:ro" \
  curlimages/curl:latest sh /smoke/smoke-quotas.sh
