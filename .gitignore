# Root level only. Each Rails service keeps its own .gitignore.

# The manifest validator installs these with --no-save at check time.
#
# Anchored with a leading slash. Without one git matches the name at any depth,
# so "package.json" quietly swallowed core/mobile-builder/package.json and the
# image failed with a bare "not found" for a file that was right there on the
# machine it was authored on.
/node_modules/
/package-lock.json
/package.json

# Development environment, written by bin/setup.
.env

*.log

# Development certificates and the CA key. Generated by bin/generate-certs.
deploy/certs/

# Python bytecode. The modules and the SDK are Python, and anything that runs
# them against the tree rather than inside an image leaves these behind.
__pycache__/
*.pyc
