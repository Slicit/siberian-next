<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · Backoffice" : "Siberian Backoffice" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "siberian", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
  </head>

  <body>
    <div class="shell">
      <aside>
        <div class="brand">
          <span class="mark">S</span>
          <span>Backoffice</span>
        </div>

        <nav class="nav stack" style="--gap:1rem">
          <%# Built from lib/navigation.rb rather than from conditionals here,
              so that what a link asks for and what its page requires cannot
              drift apart unnoticed. test/navigation_test.rb checks them
              against each other. %>
          <% Siberian::Navigation.visible(allow: method(:allow?)).each do |group| %>
            <div class="nav-group">
              <div class="label"><%= group.label %></div>
              <% group.entries.each do |entry| %>
                <%= link_to entry.label, send(entry.route),
                      "aria-current": ("page" if controller_name == entry.controller) %>
              <% end %>
            </div>
          <% end %>
        </nav>

        <div style="margin-top:auto">
          <% if current_user %>
            <div class="faint" style="font-size:.78rem">Signed in as</div>
            <div style="font-weight:600"><%= current_user.name %></div>
            <div class="muted" style="font-size:.8rem"><%= current_user.email %></div>
            <a class="muted" style="font-size:.8rem"
               href="<%= request.scheme %>://<%= current_domain.to_s.delete_prefix('admin.') %>/logout">Sign out</a>
          <% end %>
        </div>
      </aside>

      <main>
        <%= render "shared/breadcrumb" %>
        <% if flash[:notice] %><div class="notice"><%= flash[:notice] %></div><% end %>
        <% if flash[:alert] %><div class="alert"><%= flash[:alert] %></div><% end %>

        <%# The nightly sweep, on every page rather than only the dashboard.
            Nothing in this system alerts anybody: a red sweep or one that
            stopped running sat on a page an operator visits when they already
            suspect something, which is the wrong way round. Rendered only when
            there is something wrong, so a working system is silent. %>
        <% if (sweep = nightly_sweep) && sweep.available? && !sweep.ok? %>
          <div class="alert">
            <% if sweep.stale? %>
              <strong>The nightly sweep has not run for over a day.</strong>
              A green result from last week is not evidence that anything works
              today.
            <% else %>
              <strong><%= pluralize(sweep.failures.length, "nightly check") %> failing:</strong>
              <span class="mono"><%= sweep.failures.map(&:name).join(", ") %></span>.
            <% end %>
            <%= link_to "Look", root_path %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
