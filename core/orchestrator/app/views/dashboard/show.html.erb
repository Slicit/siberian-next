<% content_for :title, "Overview" %>

<div class="spread" style="margin-bottom:1.2rem">
  <div>
    <h1>Overview</h1>
    <p class="muted" style="margin:0">
      <%= pluralize(@modules.size, "module") %> installed across
      <%= pluralize(@domains.size, "domain") %>.
    </p>
  </div>
  <%= link_to "Install a module", catalog_path, class: "button primary" %>
</div>

<div class="grid">
  <%# What is wrong right now, as opposed to what was wrong last night. The
      banner in the layout says something is up; this says what, and how long
      it has been true, which is the difference between an alert and a nag. %>
  <% if @alerts&.any? %>
    <div class="card">
      <header>
        <h2>Needs attention</h2>
        <p class="muted" style="margin:.2rem 0 0; font-size:.85rem">
          Each of these was emailed once when it started and will be emailed
          once when it stops. Nothing is sent again while it stays true.
        </p>
      </header>

      <div class="stack" style="--gap:.5rem">
        <% @alerts.each do |alert| %>
          <div>
            <span class="row"><span class="dot danger"></span><%= alert.detail %></span>
            <p class="muted small" style="margin:.15rem 0 0">
              <span class="mono"><%= alert.key %></span>
              <% if alert.for_how_long %>
                &middot; for <%= alert.for_how_long %> minute<%= "s" unless alert.for_how_long == 1 %>
              <% end %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card">
    <header><h2>Core</h2></header>
    <div class="stack" style="--gap:.5rem">
      <% engine = @health.engine %>
      <div class="spread">
        <span class="row"><span class="dot <%= engine.reachable? ? 'ok' : 'danger' %>"></span>engine</span>
        <span class="muted mono"><%= engine.url %> <%= engine.detail %></span>
      </div>
      <% @health.services.each do |service| %>
        <div class="spread">
          <span class="row"><span class="dot <%= service.reachable? ? 'ok' : 'danger' %>"></span><%= service.name %></span>
          <span class="muted mono"><%= service.detail %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <header>
      <h2>Last night's checks</h2>
    </header>
    <% if !@checks.available? %>
      <p class="muted">
        The nightly sweep has not run here yet. Install it with
        <span class="mono">deploy/maintenance/install.sh</span>.
      </p>
    <% else %>
      <div class="spread" style="margin-bottom:.5rem">
        <span class="row">
          <span class="dot <%= @checks.ok? ? 'ok' : 'danger' %>"></span>
          <%= @checks.passed %> of <%= @checks.total %> passed
        </span>
        <span class="muted small">
          <%= time_ago_in_words(@checks.ran_at) %> ago, in <%= @checks.duration_seconds %>s
        </span>
      </div>

      <% if @checks.stale? %>
        <%# A green sweep from last week is not evidence that anything works
            today. Said plainly, because the failure this whole feature exists
            to stop is a check nobody noticed had stopped running. %>
        <p class="muted small" style="margin:0 0 .5rem">
          This is older than a day. The sweep may have stopped running.
        </p>
      <% end %>

      <% if @checks.failures.any? %>
        <div class="stack" style="--gap:.4rem">
          <% @checks.failures.each do |check| %>
            <div>
              <span class="row"><span class="dot danger"></span><span class="mono"><%= check.name %></span></span>
              <% if check.detail.present? %>
                <p class="muted small mono" style="margin:.15rem 0 0; white-space:pre-wrap"><%= check.detail %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="muted small" style="margin:0">
          Everything the box can check by itself is passing.
        </p>
      <% end %>
    <% end %>
  </div>

  <div class="card">
    <header><h2>Domains</h2></header>
    <% if @domains.any? %>
      <div class="stack" style="--gap:.45rem">
        <% @domains.each do |domain| %>
          <div class="spread">
            <span class="mono"><%= domain.hostname %></span>
            <% if domain.primary? %><span class="badge accent">primary</span><% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="muted">No domains yet. Modules cannot be routed until there is one.</p>
      <%= link_to "Add a domain", domains_path, class: "button" %>
    <% end %>
  </div>

  <div class="card">
    <header><h2>Catalogue</h2></header>
    <% if @catalog_entries.any? %>
      <p class="muted" style="margin-bottom:.6rem">
        <%= pluralize(@catalog_entries.count(&:valid?), "module") %> available to install.
      </p>
      <%= link_to "Browse the catalogue", catalog_path, class: "button" %>
    <% else %>
      <p class="muted">The catalogue directory is empty or unreadable.</p>
    <% end %>
  </div>
</div>

<div class="card" style="margin-top:1rem">
  <header class="spread">
    <h2>Installed modules</h2>
    <%= link_to "All modules", modules_path %>
  </header>

  <% if @modules.any? %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Module</th><th>Version</th><th>Status</th><th>Containers</th><th>Origin</th></tr>
        </thead>
        <tbody>
          <% @modules.each do |installed| %>
            <tr>
              <td><%= link_to installed.title.presence || installed.name, module_path(installed.name) %>
                  <div class="faint mono" style="font-size:.75rem"><%= installed.name %></div></td>
              <td class="mono"><%= installed.version %></td>
              <td><%= render "shared/status_badge", status: installed.status %></td>
              <td class="mono"><%= installed.module_containers.size %></td>
              <td class="mono faint"><%= installed.origin_for(@domains.first&.hostname.to_s) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      Nothing installed yet.
      <div style="margin-top:.8rem"><%= link_to "Install the first module", catalog_path, class: "button primary" %></div>
    </div>
  <% end %>
</div>

<div class="card">
  <header class="spread">
    <h2>Recent activity</h2>
    <%= link_to "Full log", activity_path %>
  </header>
  <%= render "activities/list", activities: @activities %>
</div>
