<% content_for :title, "Phone apps" %>

<div class="spread" style="margin-bottom:1.2rem">
  <div>
    <h1>Phone apps</h1>
    <p class="muted" style="margin:0">
      One app per domain, assembled from the modules that domain has installed
      and the native capabilities an operator switched on. One builder is shared
      by every domain, so a build is a place in a queue.
    </p>
  </div>
</div>

<% if @report.nil? %>
  <div class="alert">
    The Mobile service did not answer. Builds already queued are still queued;
    this page just cannot show them.
  </div>
<% else %>
  <div class="card">
    <header>
      <h2>Domains</h2>
      <p class="muted" style="margin:.2rem 0 0; font-size:.85rem">
        A domain with no app has never had one configured. Nothing is built
        until somebody asks.
      </p>
    </header>

    <% if @domains.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Domain</th><th>App</th><th>Native capabilities</th><th>Last build</th><th></th></tr></thead>
          <tbody>
            <% @domains.each do |domain| %>
              <% app = @apps[domain.hostname] %>
              <tr>
                <td>
                  <span class="mono"><%= domain.hostname %></span>
                  <% if domain.primary? %><span class="badge accent" style="margin-left:.4rem">primary</span><% end %>
                </td>
                <td>
                  <% if app %>
                    <strong><%= app["name"] %></strong>
                    <div class="faint mono" style="font-size:.72rem"><%= app["bundle_identifier"] %> · v<%= app["version"] %></div>
                  <% else %>
                    <span class="faint">not configured</span>
                  <% end %>
                </td>
                <td>
                  <% enabled = Array(app && app["capabilities"]).select { |c| c["enabled"] } %>
                  <% if enabled.any? %>
                    <div class="row wrap" style="gap:.3rem">
                      <% enabled.first(4).each do |capability| %>
                        <span class="badge"><%= capability["label"] %></span>
                      <% end %>
                      <% if enabled.length > 4 %><span class="faint">+<%= enabled.length - 4 %></span><% end %>
                    </div>
                  <% else %>
                    <span class="faint">none</span>
                  <% end %>
                  <% if Array(app && app["misconfigured"]).any? %>
                    <div class="badge warn" style="margin-top:.3rem">needs settings</div>
                  <% end %>
                </td>
                <td>
                  <% build = app && app["latest_build"] %>
                  <% if build %>
                    <span class="badge <%= build['state'] == 'succeeded' ? '' : build['state'] == 'dead' ? 'danger' : 'warn' %>">
                      <%= build["state"] %>
                    </span>
                    <div class="faint" style="font-size:.72rem"><%= build["platform"] %></div>
                  <% else %>
                    <span class="faint">never</span>
                  <% end %>
                </td>
                <td class="right">
                  <%= link_to((app ? "Configure" : "Set up"), mobile_app_path(domain.hostname), class: "button") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">No domains yet. An app belongs to a domain, so there is nothing to configure.</div>
    <% end %>
  </div>

  <div class="card">
    <header>
      <h2>The queue</h2>
      <p class="muted" style="margin:.2rem 0 0; font-size:.85rem">
        <%= pluralize(@queue&.dig("queued").to_i, "build") %> waiting,
        <%= @queue&.dig("building").to_i %> running. The builder takes one at a
        time, so a queue is what a shared container looks like when two domains
        want something at once.
      </p>
    </header>

    <% recent = Array(@queue && @queue["builds"]).first(10) %>
    <% if recent.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Domain</th><th>Platform</th><th>State</th><th>Attempts</th><th>Asked by</th></tr></thead>
          <tbody>
            <% recent.each do |build| %>
              <tr>
                <td class="mono" style="font-size:.82rem"><%= build["domain"] %></td>
                <td><%= build["platform"] %></td>
                <td>
                  <span class="badge <%= build['state'] == 'succeeded' ? '' : build['state'] == 'dead' ? 'danger' : 'warn' %>">
                    <%= build["state"] %>
                  </span>
                  <% if build["last_error"].present? %>
                    <div class="faint" style="font-size:.72rem"><%= truncate(build["last_error"], length: 70) %></div>
                  <% end %>
                </td>
                <td><%= build["attempts"] %></td>
                <td class="faint" style="font-size:.78rem"><%= build["requested_by"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">Nothing has been built yet.</div>
    <% end %>
  </div>
<% end %>
