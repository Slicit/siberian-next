<% content_for :title, "Phone app" %>
<% helper = ActiveSupport::NumberHelper %>

<div style="margin-bottom:1.2rem">
  <h1>Phone app</h1>
  <p class="muted" style="margin:0">
    One app for <span class="mono"><%= current_domain %></span>, built from the
    modules installed here and the native capabilities switched on below.
  </p>
</div>

<div class="card">
  <header>
    <h2>Describe it</h2>
    <p class="muted" style="margin:.2rem 0 0; font-size:.85rem">
      Say what the app is for and the assistant proposes a configuration. It
      proposes only: nothing changes until you accept it, capability by
      capability.
    </p>
  </header>

  <%= form_with url: suggest_phone_app_path, method: :post, class: "stack" do %>
    <div class="field">
      <%= text_area_tag :description, @description, rows: 4,
            placeholder: "A field service app for our engineers. They need to find the next job on a map, take photos of what they fixed, and work in basements with no signal." %>
    </div>
    <button type="submit" class="primary">Ask</button>
  <% end %>
</div>

<% if @proposal %>
  <div class="card">
    <header>
      <h2>What it suggests</h2>
      <p class="muted" style="margin:.2rem 0 0; font-size:.85rem"><%= @proposal["summary"] %></p>
    </header>

    <%= form_with url: apply_phone_app_path, method: :patch, class: "stack" do %>
      <div class="row" style="gap:.6rem; align-items:flex-end; flex-wrap:wrap">
        <div class="field" style="max-width:14rem">
          <%= label_tag :name, "Name" %>
          <%= text_field_tag :name, @proposal["name"] %>
        </div>
        <div class="field" style="max-width:16rem">
          <%= label_tag :bundle_identifier, "Bundle identifier" %>
          <%= text_field_tag :bundle_identifier, @proposal["bundle_identifier"] %>
        </div>
        <div class="field" style="max-width:9rem">
          <%= label_tag :primary_color, "Accent" %>
          <%= text_field_tag :primary_color, @proposal["primary_color"] %>
        </div>
      </div>

      <% proposed = Array(@proposal["capabilities"]) %>
      <% if proposed.any? %>
        <div class="stack" style="--gap:.5rem">
          <div class="label">Capabilities it would switch on</div>
          <% proposed.each do |capability| %>
            <label class="row" style="align-items:flex-start; gap:.6rem; padding:.6rem; border:1px solid var(--line); border-radius:8px">
              <%= check_box_tag "capabilities[]", capability["id"], true, style: "width:auto; margin-top:.25rem" %>
              <span>
                <strong><%= capability["label"] %></strong>
                <% if capability["severity"] == "high" %>
                  <span class="badge warn" style="margin-left:.3rem">asks a lot</span>
                <% end %>
                <div class="muted" style="font-size:.84rem"><%= capability["reason"] %></div>
                <div class="faint mono" style="font-size:.72rem"><%= capability["package"] %></div>
                <% if Array(capability["settings"]).any? %>
                  <div class="faint" style="font-size:.78rem">
                    Will not work until <%= Array(capability["settings"]).map { |s| s["label"] }.to_sentence %> are supplied.
                  </div>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="muted" style="margin:0">It proposes no native capabilities for this.</p>
      <% end %>

      <button type="submit" class="primary">Accept what is ticked</button>
    <% end %>
  </div>
<% end %>

<% if @app %>
  <% splash = @app["splash"] || {} %>
  <div class="card">
    <header>
      <h2>Splash</h2>
      <p class="muted" style="margin:.2rem 0 0; font-size:.85rem">
        What the app shows before it has drawn anything. A square image is
        centred on screens of every shape, so nothing gets cropped.
      </p>
    </header>

    <div class="row wrap" style="gap:.5rem; margin-bottom:.8rem">
      <span class="badge <%= splash["image"] ? "" : "warn" %>">image: <%= splash["image"] ? "set" : "none" %></span>
      <span class="badge <%= splash["animation"] ? "" : "warn" %>">Android animation: <%= splash["animation"] ? "set" : "none" %></span>
      <% if splash["background"].present? %>
        <span class="badge">background <%= splash["background"] %></span>
      <% end %>
    </div>

    <%= form_with url: phone_app_splash_path, method: :post, class: "stack", multipart: true do %>
      <div class="field">
        <%= label_tag :image, "Splash image (PNG)" %>
        <%= file_field_tag :image, accept: "image/png" %>
        <div class="hint">
          Square, <%= splash["recommended_px"] || 2500 %> by
          <%= splash["recommended_px"] || 2500 %>. Keep the logo inside the centre
          <%= splash["safe_zone_px"] || 1650 %> pixels: Android masks the splash
          icon to a circle and crops what is outside it.
        </div>
      </div>
      <div class="field" style="max-width:11rem">
        <%= label_tag :background, "Background" %>
        <%= text_field_tag :background, splash["background"], placeholder: "#ffffff" %>
      </div>
      <button type="submit" class="primary">Upload image</button>
    <% end %>

    <hr style="border:0; border-top:1px solid var(--line); margin:1rem 0">

    <%= form_with url: phone_app_splash_path, method: :post, class: "stack", multipart: true do %>
      <div class="field">
        <%= label_tag :animation, "Android animation (AnimatedVectorDrawable XML)" %>
        <%= file_field_tag :animation, accept: ".xml,text/xml,application/xml" %>
        <div class="hint">
          Android animates a splash from an AnimatedVectorDrawable and nothing
          else: not a GIF, not a video, not a sequence of frames. iOS has no
          equivalent, so this changes nothing there.
        </div>
      </div>
      <div class="field" style="max-width:11rem">
        <%= label_tag :duration_ms, "Duration (ms)" %>
        <%= number_field_tag :duration_ms, splash["animation_duration_ms"] || 1000, min: 0, max: 1000 %>
        <div class="hint">Android stops it at 1000 whatever this says.</div>
      </div>
      <button type="submit">Upload animation</button>
    <% end %>

    <% if splash["image"] || splash["animation"] %>
      <div class="row" style="gap:.4rem; margin-top:.8rem">
        <% if splash["image"] %>
          <%= button_to "Remove image", phone_app_splash_path, method: :delete, class: "button danger",
                params: { kind: "image" },
                form: { data: { turbo_confirm: "Remove the splash image? The next build falls back to a plain background." } } %>
        <% end %>
        <% if splash["animation"] %>
          <%= button_to "Remove animation", phone_app_splash_path, method: :delete, class: "button danger",
                params: { kind: "animation" },
                form: { data: { turbo_confirm: "Remove the Android animation? The next build shows the still image instead." } } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="card">
    <header>
      <h2><%= @app["name"] %></h2>
      <p class="muted" style="margin:.2rem 0 0; font-size:.85rem">
        <span class="mono"><%= @app["bundle_identifier"] %></span> ·
        version <%= @app["version"] %> · build <%= @app["build_number"] %>
      </p>
    </header>

    <% configured = Array(@app["capabilities"]).index_by { |row| row["capability"] } %>
    <% @catalogue.each do |capability| %>
      <% row = configured[capability["id"]] %>
      <% on = row && row["enabled"] %>
      <div class="spread" style="padding:.6rem 0; border-bottom:1px solid var(--line)">
        <div>
          <strong><%= capability["label"] %></strong>
          <span class="state <%= on ? "on" : "off" %>" style="margin-left:.4rem">
            <span class="dot <%= on ? "ok" : "" %>"></span><%= on ? "on" : "off" %>
          </span>
          <% if capability["severity"] == "high" %>
            <span class="badge warn" style="margin-left:.3rem">asks a lot</span>
          <% end %>
          <div class="muted" style="font-size:.82rem"><%= capability["summary"] %></div>
        </div>
        <%= button_to((on ? "Turn off" : "Turn on"),
              phone_app_capability_path(capability["id"]), method: :patch,
              class: "button toggle #{on ? 'on' : 'off'}",
              params: { enabled: on ? "false" : "true" },
              form: { data: { turbo_confirm: (on || capability["severity"] != "high") ? nil : "#{capability['label']} asks a lot of somebody using this app. Switch it on?" } }) %>
      </div>
    <% end %>

    <% if Array(@app["misconfigured"]).any? %>
      <div class="alert" style="margin-top:.8rem">
        <% @app["misconfigured"].each do |entry| %>
          <div>
            <%= entry["capability"] %> is on but has no
            <%= Array(entry["missing"]).to_sentence %>. Somebody with access to the
            Backoffice has to supply those before a build will run.
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# The app, running, on the page where it was configured. A web export is
      the same JavaScript the phone loads in its WebView, so what is in the
      frame is the app rather than a picture of it: the theme, the tab bar and
      the modules are all the real ones. What it cannot show is anything the
      phone does that a browser will not, which is why the capabilities above
      say so themselves rather than being demonstrated here. %>
  <div class="card">
    <header>
      <div class="spread">
        <div>
          <h2>Preview</h2>
          <p class="muted" style="margin:.2rem 0 0; font-size:.85rem">
            A web build of the same app, so you can look at it before you ship it.
            Rebuild it after changing anything here.
          </p>
        </div>
        <%= button_to @preview_build ? "Rebuild preview" : "Build preview",
              build_phone_app_path, class: "button", params: { platform: "web" } %>
      </div>
    </header>

    <% if @preview_build %>
      <div style="display:flex; justify-content:center; padding:1rem 0">
        <div style="width:390px; max-width:100%; height:720px; border:10px solid #1c1c1e;
                    border-radius:34px; overflow:hidden; background:#000;
                    box-shadow:0 12px 40px rgba(0,0,0,.25)">
          <iframe src="<%= preview_phone_app_path %>" title="Phone app preview"
                  style="width:100%; height:100%; border:0; display:block; background:#fff"></iframe>
        </div>
      </div>
      <p class="faint" style="font-size:.75rem; text-align:center">
        Built <%= @preview_build["finished_at"] %>.
        <%= link_to "Open it in a tab", preview_phone_app_path, target: "_blank", rel: "noopener" %>
      </p>
    <% elsif @preview_pending %>
      <div class="empty">
        The preview is building. A web build takes about a minute; this page
        will show it once it has finished.
      </div>
    <% else %>
      <div class="empty">
        No preview built yet. A web build takes about a minute and does not
        queue behind the long Android ones.
      </div>
    <% end %>
  </div>

  <div class="card">
    <header>
      <div class="spread">
        <div>
          <h2>Builds</h2>
          <p class="muted" style="margin:.2rem 0 0; font-size:.85rem">
            One builder is shared by every domain, so asking for a build is
            asking to be next.
            <% if @building.to_i.positive? || @queued.to_i.positive? %>
              <br>
              Right now: <%= pluralize(@building.to_i, "build") %> running,
              <%= pluralize(@queued.to_i, "waiting") %> across every domain.
            <% end %>
          </p>
        </div>
        <div class="row" style="gap:.4rem">
          <%= button_to "Build for Android", build_phone_app_path, class: "button primary",
                params: { platform: "android" } %>
          <%= button_to "iOS project", build_phone_app_path, class: "button",
                params: { platform: "ios" },
                form: { data: { turbo_confirm: "iOS cannot be compiled on Linux. This produces the configured Xcode project, which is what a macOS runner needs. Continue?" } } %>
        </div>
      </div>
    </header>

    <% if @builds.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>When</th><th>Platform</th><th>State</th><th>Artifact</th></tr></thead>
          <tbody>
            <% @builds.first(5).each do |build| %>
              <tr>
                <td class="faint" style="font-size:.78rem"><%= build["created_at"] %></td>
                <td><%= build["platform"] %></td>
                <td>
                  <span class="badge <%= build["state"] == "succeeded" ? "" : build["state"] == "dead" ? "danger" : "warn" %>">
                    <%= build["state"] %>
                  </span>
                  <% if build["position"] %>
                    <span class="faint" style="font-size:.72rem">
                      number <%= build["position"] %> in line
                    </span>
                  <% end %>
                  <% if build["last_error"].present? %>
                    <div class="faint" style="font-size:.72rem"><%= truncate(build["last_error"], length: 70) %></div>
                  <% end %>
                </td>
                <td class="mono" style="font-size:.75rem">
                  <%= build["artifact_path"].presence || "none" %>
                  <% if build["artifact_bytes"].to_i.positive? %>
                    <div class="faint"><%= helper.number_to_human_size(build["artifact_bytes"].to_i) %></div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <% if @builds_unavailable %>
          The build queue did not answer. Nothing is lost; this page cannot
          show it right now.
        <% else %>
          Nothing built yet.
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card">
    <div class="empty">
      No app for this domain yet. Describe what it is for above, or fill the
      form in by hand once a proposal has given you a starting point.
    </div>
  </div>
<% end %>
