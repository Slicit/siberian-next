<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · Siberian" : "Siberian" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "siberian", "data-turbo-track": "reload" %>
  </head>

  <body>
    <div class="shell">
      <aside>
        <div class="brand">
          <span class="mark">S</span>
          <span>Siberian</span>
        </div>

        <nav class="nav stack" style="--gap:1rem">
          <div class="nav-group">
            <div class="label">Home</div>
            <%= link_to "Overview", root_path, "aria-current": ("page" if current_page?(root_path)) %>
            <% if allow?("core.mobile.manage") %>
              <%= link_to "Phone app", phone_app_path, "aria-current": ("page" if controller_name == "phone_app") %>
            <% end %>
          </div>

          <%# Every group here came from an installed module. Nothing in this
              file names one, which is why installing a module does not require
              touching the shell. %>
          <% (@groups || []).each do |label, capabilities| %>
            <div class="nav-group">
              <div class="label"><%= label %></div>
              <% capabilities.each do |capability| %>
                <%= link_to module_frame_path(capability.slug),
                      "aria-current": ("page" if @capability&.id == capability.id) do %>
                  <span class="grow"><%= capability.title %></span>
                  <% unless capability.healthy? %>
                    <span class="dot warn" title="<%= capability.module_name %> is <%= capability.status %>"></span>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </nav>

        <div style="margin-top:auto">
          <% if current_user %>
            <div class="faint" style="font-size:.78rem">Signed in as</div>
            <div style="font-weight:600"><%= current_user.name %></div>
            <div class="muted" style="font-size:.8rem"><%= current_user.email %></div>
            <div class="row" style="gap:.6rem; margin-top:.3rem">
              <a class="muted" style="font-size:.8rem" href="/logout">Sign out</a>
              <% if current_user.operator? %>
                <a class="muted" style="font-size:.8rem"
                   href="<%= request.scheme %>://admin.<%= current_domain %>/">Backoffice</a>
              <% end %>
            </div>
          <% end %>
        </div>
      </aside>

      <main>
        <%= render "shared/breadcrumb" %>
        <% if flash[:notice] %><div class="notice"><%= flash[:notice] %></div><% end %>
        <% if flash[:alert] %><div class="alert"><%= flash[:alert] %></div><% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
