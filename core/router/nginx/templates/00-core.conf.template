# Core routes. Rendered at container start from environment.
#
#   SIBERIAN_DOMAIN    the domain being served, for example example.com
#   SIBERIAN_RESOLVER  address of the container network's embedded DNS
#
# One rendered copy per served domain. Multi-domain means several of these, all
# pointing at the same containers: isolation is at the data layer, not the
# runtime layer (LOGBOOK.md, Conventions).
#
# Everything user-facing is HTTPS. Browsers refuse plain HTTP for anything that
# looks like an app, and the session cookie has to be Secure to travel into a
# module frame on another origin, so TLS is not a production-only concern here.

# Plain HTTP exists only to send people to HTTPS.
server {
  listen 80 default_server;
  server_name _;
  return 301 https://$host$request_uri;
}

# Base App. The product shell that wraps installed modules in iframes.
server {
  listen 443 ssl;
  http2 on;
  server_name ${SIBERIAN_DOMAIN};

  ssl_certificate     /etc/nginx/certs/server.pem;
  ssl_certificate_key /etc/nginx/certs/server-key.pem;

  # Container names resolve through the network's embedded DNS. Its address
  # differs by engine, so it is rendered rather than hardcoded.
  resolver ${SIBERIAN_RESOLVER} valid=10s ipv6=off;

  # The app's door into a module.
  #
  # An app has no origins. Every module's native code runs in one JavaScript
  # context, in one process, so nothing on the device can stop one module's code
  # from calling another's endpoint. The boundary therefore lives here: the
  # module is the first path segment, this block sets the module identity from
  # that segment rather than from anything the client sends, and the call is
  # authorised as the user, against module.<name>.use, exactly as the browser
  # path is.
  #
  # Two segments, deliberately. The Base App already serves /m/<capability-id>
  # for a framed page, and that has no second segment, so it falls through to
  # the location below. A regex location wins over a prefix one in nginx, which
  # is what makes these two coexist without either knowing about the other.
  location ~ "^/m/([a-z0-9][a-z0-9-]*)/(.*)$" {
    set $module_name $1;
    set $module_path $2;
    # An unknown module maps to nothing. Answering 404 here is the difference
    # between "no such module" and a 502 from proxying at a name that is not
    # there.
    if ($module_upstream = "") { return 404 "no such module\n"; }

    set $upstream_module "http://$module_upstream";
    proxy_pass $upstream_module/$module_path$is_args$args;
    include /etc/nginx/siberian/forwarded_headers.conf;

    # Set here, never accepted from the client: a header a caller can write is
    # not an identity.
    proxy_set_header X-Siberian-Module $module_name;
  }

  # Sign in and out are served by Auth on the main domain, so the cookie it
  # sets is scoped to the domain every module frame sits under. The Base App
  # never sees a password.
  location ~ ^/(login|logout)$ {
    set $upstream_auth "http://auth:3000";
    proxy_pass $upstream_auth;
    include /etc/nginx/siberian/forwarded_headers.conf;
  }

  location / {
    set $upstream_base "http://base:3000";
    proxy_pass $upstream_base;
    include /etc/nginx/siberian/forwarded_headers.conf;
  }
}

# Orchestrator. Operator-facing, deliberately on its own origin so a compromised
# module frame has no path to it.
#
# core.<domain> rather than a domain of its own: the session cookie is scoped to
# .<domain>, so a Backoffice outside that scope would receive no session at all
# and would need a login of its own.
server {
  listen 443 ssl;
  http2 on;
  server_name core.${SIBERIAN_DOMAIN};

  ssl_certificate     /etc/nginx/certs/server.pem;
  ssl_certificate_key /etc/nginx/certs/server-key.pem;

  resolver ${SIBERIAN_RESOLVER} valid=10s ipv6=off;

  location / {
    set $upstream_admin "http://orchestrator:3000";
    proxy_pass $upstream_admin;
    include /etc/nginx/siberian/forwarded_headers.conf;

    # The Backoffice is never framed, by anything.
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
  }
}

# The internal entry point for modules.
#
# A module sits on its own network with only the Router attached, so it cannot
# address auth or storage directly. It reaches them here, at http://core/...,
# which is the rule LOGBOOK.md states for module to module traffic: it goes
# through the Router, by construction rather than by convention.
#
# Plain HTTP on purpose: this is container to container on a private network,
# and it answers only to the internal name "core", which no public DNS resolves
# and no browser sends.
#
# Each location sets its upstream and then rewrites the prefix away. The order
# matters: `rewrite ... break` ends the rewrite phase and `set` belongs to the
# same module, so a `set` written after the rewrite never runs and nginx answers
# 500 with "invalid URL prefix in ''". The rewrite itself is needed because
# proxy_pass does not strip a location prefix when its argument is a variable,
# and the variable is needed so nginx resolves the upstream per request rather
# than pinning it at startup.
server {
  listen 80;
  server_name core;
  resolver ${SIBERIAN_RESOLVER} valid=10s ipv6=off;

  location /auth/ {
    set $upstream_auth "http://auth:3000";
    rewrite ^/auth/(.*)$ /$1 break;
    proxy_pass $upstream_auth;
    include /etc/nginx/siberian/internal_headers.conf;
  }

  location /storage/ {
    set $upstream_storage "http://storage:3000";
    rewrite ^/storage/(.*)$ /$1 break;
    proxy_pass $upstream_storage;
    include /etc/nginx/siberian/internal_headers.conf;
  }

  location /database/ {
    set $upstream_database "http://database:3000";
    rewrite ^/database/(.*)$ /$1 break;
    proxy_pass $upstream_database;
    include /etc/nginx/siberian/internal_headers.conf;
  }

  location /mailer/ {
    set $upstream_mailer "http://mailer:3000";
    rewrite ^/mailer/(.*)$ /$1 break;
    proxy_pass $upstream_mailer;
    include /etc/nginx/siberian/internal_headers.conf;
  }

  location /orchestrator/ {
    set $upstream_orchestrator "http://orchestrator:3000";
    rewrite ^/orchestrator/(.*)$ /$1 break;
    proxy_pass $upstream_orchestrator;
    include /etc/nginx/siberian/internal_headers.conf;
  }

  location / {
    return 404 "no such core service\n";
  }
}

# The other direction: core services reaching into a module.
#
# Modules address the core at http://core/..., and until now nothing went the
# other way. The Mailer resolving a transport that lives in a module could see
# its URL and had no route to it, which presents as a DNS failure rather than as
# a missing door.
#
# Symmetric with the core block, and reachable only from inside: it answers to
# the name "modules", which no public DNS resolves and no browser sends. The
# Router is the only container attached to every module network, which is
# exactly why it is the one that can do this.
server {
  listen 80;
  server_name modules;
  resolver ${SIBERIAN_RESOLVER} valid=10s ipv6=off;

  # /<module>/<path> proxies to the module short name, which resolves on that
  # module network. Nothing here learns a uuid or a container name.
  location ~ ^/([a-z0-9][a-z0-9-]*)/(.*)$ {
    set $module_name $1;
    set $module_path $2;
    set $upstream_module "http://$module_name";
    proxy_pass $upstream_module/$module_path$is_args$args;
    include /etc/nginx/siberian/internal_headers.conf;
  }

  location / {
    return 404 "address a module as /<module-name>/<path>";
  }
}
